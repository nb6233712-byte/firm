{
  "hosting": {
    "target": "firm",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "tests/**",
      "test-pdfs/**",
      "scripts/**",
      "*.md",
      "*.rules*",
      "cors.json",
      "firestore.indexes.json",
      "firm/**",
      "client/**",
      "client-portal/**",
      "shared-backend/**"
    ],
    "rewrites": [
      {
        "source": "/api/webhooks/persona",
        "function": "handleKbaWebhook"
      },
      {
        "source": "/handleKbaWebhook",
        "function": "handleKbaWebhook"
      },
      {
        "source": "/api/webhooks/stripe",
        "function": "handleStripeWebhook"
      },
      {
        "source": "/handleStripeWebhook",
        "function": "handleStripeWebhook"
      },
      {
        "source": "/api/documents/download",
        "function": "downloadDocument"
      },
      {
        "source": "/downloadDocument",
        "function": "downloadDocument"
      },
      {
        "source": "/intakeDocumentFallback",
        "function": "intakeDocumentFallback"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*",
        "headers": [
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), payment=(self)" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
